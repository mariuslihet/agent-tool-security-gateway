# Generate real local values with npm run init. Do not use these placeholders.
GATEWAY_MASTER_KEY=replace-with-a-random-protected-storage-key
GATEWAY_AGENT_TOKEN=replace-with-a-separate-random-agent-token
GATEWAY_OPERATOR_TOKEN=replace-with-a-separate-random-operator-token
GATEWAY_VIEWER_TOKEN=replace-with-a-separate-random-viewer-token
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
GATEWAY_DB=var/gateway.sqlite

# Optional real local inference. Pull a tool-capable model in Ollama first.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional host-reviewed workspace. Defaults to ./workspace when it exists.
# Must contain input/ and reports/. Use "off" to disable these tools.
GATEWAY_WORKSPACE_ROOT=workspace

# Optional host-reviewed fixed-query SQLite connector configuration.
# GATEWAY_CONNECTORS_FILE=connector-example/connector.json
# For host backup commands only: set a separate private passphrase (16+ characters).
# GATEWAY_BACKUP_PASSPHRASE is never sent to the browser and is not included in backups.
