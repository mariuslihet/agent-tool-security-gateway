# Generate real local values with npm run init. Do not use these placeholders.
GATEWAY_MASTER_KEY=replace-with-a-random-protected-storage-key
GATEWAY_AGENT_TOKEN=replace-with-a-separate-random-agent-token
GATEWAY_OPERATOR_TOKEN=replace-with-a-separate-random-operator-token
GATEWAY_VIEWER_TOKEN=replace-with-a-separate-random-viewer-token
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
GATEWAY_DB=var/gateway.sqlite
